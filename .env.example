# Copy this file to .env and fill in real values. All three are required —
# docker compose refuses to start if any are missing.

# Must exactly match a model already pulled on the HOST machine's Ollama
# (run `ollama pull <name>` on the host, then `ollama list` to confirm).
# Ollama itself is NOT containerized — it must run natively on the host.
EDF_CHAT_MODEL=gemma3:12b
EDF_EMBED_MODEL=nomic-embed-text

# How containers reach the host's Ollama server. host.docker.internal is a
# Docker-Desktop-for-Windows/Mac feature and resolves automatically there.
# On native Linux Docker Engine this needs `extra_hosts: ["host.docker.internal:host-gateway"]`
# added to the backend/frontend services in docker-compose.yaml instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional performance tuning (defaults shown; safe to omit).
# EDF_NUM_GPU=99        # 99 = offload all layers to GPU; 0 = force CPU-only
# EDF_MAIN_GPU=0         # which physical GPU (0 or 1 on this dual-GPU host) to pin to
# EDF_NUM_CTX=8192       # context window cap; actual prompts are ~2-2.5k tokens
